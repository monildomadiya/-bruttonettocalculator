# Copy to .env on the server (never commit real values — .env is gitignored).

# ── Stories (Cloudinary) ─────────────────────────────────────────────
# Cloudinary Console → Settings → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Password for /admin/stories — at least 12 characters, e.g. `openssl rand -base64 24`
STORIES_ADMIN_PASSWORD=
